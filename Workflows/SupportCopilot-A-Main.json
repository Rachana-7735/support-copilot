    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\n\nconst cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Claude did not return valid JSON: ' + cleaned);\n}\n\nconst allowedCategories = ['shipping', 'refund', 'product', 'account', 'other'];\nconst allowedUrgency = ['low', 'normal', 'high'];\n\nif (!allowedCategories.includes(parsed.category)) {\n  parsed.category = 'other';\n}\nif (!allowedUrgency.includes(parsed.urgency)) {\n  parsed.urgency = 'normal';\n}\n\nreturn [{\n  json: {\n    category: parsed.category,\n    urgency: parsed.urgency\n  }\n}];"
      },
