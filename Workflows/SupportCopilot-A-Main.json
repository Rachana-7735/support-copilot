        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 200,\n  \"system\": \"You classify customer support messages. Reply with ONLY a JSON object, no other text: {\\\"category\\\": \\\"...\\\", \\\"urgency\\\": \\\"...\\\"}. category must be one of: shipping, refund, product, account, other. urgency must be one of: low, normal, high.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Subject: {{ $('Validate').item.json.subject }}\\n\\nBody: {{ $('Validate').item.json.message_body }}\"\n    }\n  ]\n}",
