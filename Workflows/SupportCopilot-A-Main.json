      "parameters": {
        "jsCode": "const input = $input.first().json.body;\n\nif (!input) {\n  throw new Error('No body received');\n}\n\nconst required = ['from', 'subject', 'body', 'message_id'];\nfor (const field of required) {\n  if (!input[field] || String(input[field]).trim() === '') {\n    throw new Error('Missing required field: ' + field);\n  }\n}\n\nif (!String(input.from).includes('@')) {\n  throw new Error('Invalid email address');\n}\n\nif (String(input.body).length > 20000) {\n  throw new Error('Message too long');\n}\n\nreturn [{\n  json: {\n    customer_email: String(input.from).trim().toLowerCase(),\n    subject: String(input.subject).trim(),\n    message_body: String(input.body).trim(),\n    message_id: String(input.message_id).trim()\n  }\n}];"
