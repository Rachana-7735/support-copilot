        "subject": "=[Approval needed] {{ $('Validate').item.json.subject }}",
        "html": "=<h3>Draft reply ready for review</h3>\n\n<p><b>From:</b> {{ $('Validate').item.json.customer_email }}<br>\n<b>Subject:</b> {{ $('Validate').item.json.subject }}<br>\n<b>Category:</b> {{ $('Parse Classification').item.json.category }} &nbsp;\n<b>Urgency:</b> {{ $('Parse Classification').item.json.urgency }}</p>\n\n<h4>Customer wrote:</h4>\n<p style=\"background:#f4f4f4;padding:10px;\">{{ $('Validate').item.json.message_body }}</p>\n\n<h4>Proposed reply:</h4>\n<p style=\"background:#eef7ee;padding:10px;white-space:pre-wrap;\">{{ $('Parse Draft').item.json.draft_reply }}</p>\n\n<h4>Grounding</h4>\n<p>Confidence: {{ $('Parse Draft').item.json.confidence }}<br>\nTop similarity: {{ $('Parse Draft').item.json.top_similarity }}<br>\nSources: {{ $('Parse Draft').item.json.citations.join('<br>') }}</p>\n\n<p>\n<a href=\"https://rachanapra.app.n8n.cloud/webhook/approve?approval_id={{ $json.id }}&token={{ $json.token }}&decision=approve\"\n   style=\"background:#2e7d32;color:#fff;padding:10px 20px;text-decoration:none;\">APPROVE</a>\n&nbsp;&nbsp;\n<a href=\"https://rachanapra.app.n8n.cloud/webhook/approve?approval_id={{ $json.id }}&token={{ $json.token }}&decision=reject\"\n   style=\"background:#c62828;color:#fff;padding:10px 20px;text-decoration:none;\">REJECT</a>\n</p>",
